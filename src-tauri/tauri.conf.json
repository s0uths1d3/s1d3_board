{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "s1d3_board",
  "version": "0.1.0",
  "identifier": "S1d3Board",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:12912",
    "beforeDevCommand": "npm run dev -- --port 12912",
    "beforeBuildCommand": "npm run generate"
  },
  "app": {
    "windows": [
      {
        "title": "s1d3 board",
        "width": 854,
        "height": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_64x64.ico",
      "icons/icon.png"
    ],
    "resources": [
      "icons/icon_256x256.ico"
    ]
  }
}
